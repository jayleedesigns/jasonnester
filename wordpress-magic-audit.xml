    <item>
      <title>Magic Audit</title>
      <link>https://lookadiss.com/geminicreative/magic-audit/</link>
      <pubDate>Sat, 28 Mar 2026 00:00:00 +0000</pubDate>
      <dc:creator><![CDATA[admin]]></dc:creator>
      <guid isPermaLink="false">magic-audit-import-1</guid>
      <description></description>
      <content:encoded><![CDATA[
<!-- wp:html -->
<div id="gc-audit" class="gc-audit">
  <div class="gc-wrap">
    <header class="gc-head">
      <h1>Gemini <span>Creative</span> Magic Audit</h1>
      <p id="gc-live">Live audit: None</p>
    </header>

    <section id="gc-step-input" class="gc-step active">
      <div class="gc-card">
        <h2>Stop Guessing. Start Winning.</h2>
        <p>Analyze your website performance and book your strategy session.</p>
        <form id="gc-form">
          <label>Your Website URL
            <input id="gc-url" type="url" required placeholder="https://yourbrand.com" />
          </label>
          <label>Competitor URL (optional)
            <input id="gc-comp" type="url" placeholder="https://rivalbrand.com" />
          </label>
          <label>Report Recipient
            <input id="gc-email" type="email" required placeholder="hello@company.com" />
          </label>
          <button type="submit">Reveal the Magic</button>
        </form>
      </div>
    </section>

    <section id="gc-step-scan" class="gc-step">
      <div class="gc-card center">
        <h2>Summoning Data...</h2>
        <p id="gc-scan-text"></p>
        <div class="gc-progress"><span id="gc-progress-bar"></span></div>
      </div>
    </section>

    <section id="gc-step-report" class="gc-step">
      <div class="gc-card">
        <h2>Your Magic Score: <span id="gc-score">82</span></h2>
        <p id="gc-report-target"></p>
        <div class="gc-grid" id="gc-metrics"></div>
        <div id="gc-rival" class="gc-rival" hidden></div>
        <div class="gc-actions">
          <button id="gc-voice" type="button">Listen to Report</button>
          <button id="gc-mock" type="button">Generate Vision Mockup</button>
          <button id="gc-next" type="button">Claim Free Strategy Session</button>
        </div>
        <div id="gc-mockup" class="gc-mockup">No mockup generated yet.</div>
      </div>
    </section>

    <section id="gc-step-book" class="gc-step">
      <div class="gc-card">
        <h2>Pick Your Magic Hour</h2>
        <div class="gc-booking">
          <div>
            <h3>Select Date</h3>
            <div class="gc-options" id="gc-date-options"></div>
          </div>
          <div>
            <h3>Select Time</h3>
            <div class="gc-options" id="gc-time-options"></div>
          </div>
        </div>
        <button id="gc-finalize" type="button" disabled>Finalize My Session</button>
        <p id="gc-book-status" style="margin-top:10px;color:#cbd5e1"></p>
      </div>
    </section>

    <section id="gc-step-success" class="gc-step">
      <div class="gc-card center">
        <h2>Magic Confirmed!</h2>
        <p id="gc-success-copy"></p>
        <button id="gc-reset" type="button">Start New Audit</button>
      </div>
    </section>
  </div>
</div>

<style>
  .gc-audit{background:#0f172a;color:#e2e8f0;font-family:Inter,Arial,sans-serif;padding:24px;border-radius:20px}
  .gc-wrap{max-width:980px;margin:0 auto}
  .gc-head{display:flex;justify-content:space-between;align-items:end;gap:16px;margin-bottom:24px}
  .gc-head h1{margin:0;font-size:32px}.gc-head span{color:#818cf8}.gc-head p{margin:0;color:#94a3b8}
  .gc-step{display:none}.gc-step.active{display:block}
  .gc-card{background:#1e293bcc;border:1px solid #334155;border-radius:16px;padding:24px}
  .gc-card.center{text-align:center}
  .gc-card h2{margin-top:0}
  #gc-form{display:grid;gap:12px}#gc-form label{display:grid;gap:6px;font-weight:600}
  #gc-form input{padding:12px;border-radius:10px;border:1px solid #475569;background:#0f172a;color:#f8fafc}
  button{background:linear-gradient(90deg,#4f46e5,#7c3aed);color:#fff;border:0;border-radius:10px;padding:12px 16px;font-weight:700;cursor:pointer}
  button[disabled]{opacity:.45;cursor:not-allowed}
  .gc-loading{opacity:.7;pointer-events:none}
  .gc-progress{height:10px;background:#334155;border-radius:999px;overflow:hidden;margin-top:16px}
  .gc-progress span{display:block;height:100%;width:0;background:linear-gradient(90deg,#6366f1,#a855f7)}
  .gc-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin:16px 0}
  .gc-metric{background:#0f172a;border:1px solid #334155;border-radius:12px;padding:14px}
  .gc-rival{margin:12px 0;padding:12px;border:1px solid #7f1d1d;background:#450a0a3d;border-radius:12px}
  .gc-actions{display:flex;flex-wrap:wrap;gap:10px;margin:16px 0}
  .gc-mockup{border:1px dashed #475569;border-radius:12px;min-height:190px;display:flex;align-items:center;justify-content:center;padding:14px;color:#94a3b8;background:#0f172a}
  .gc-mockup img{max-width:100%;border-radius:10px}
  .gc-booking{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px;margin-bottom:16px}
  .gc-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
  .gc-choice{background:#0f172a;border:1px solid #475569;border-radius:8px;padding:10px;text-align:center;cursor:pointer}
  .gc-choice.active{background:#4f46e5;border-color:#818cf8}
</style>

<script>
(() => {
  const $ = (id) => document.getElementById(id);
  const steps = {
    input: $('gc-step-input'), scan: $('gc-step-scan'), report: $('gc-step-report'),
    book: $('gc-step-book'), success: $('gc-step-success')
  };
  const state = { url: '', comp: '', email: '', selectedDate: '', selectedTime: '' };

  const metrics = [
    ['Speed Alchemy', 94], ['SEO Spells', 71], ['Visual Magic', 85], ['Conversion', 64]
  ];
  const dates = ['Mon 30', 'Tue 31', 'Wed 01', 'Thu 02', 'Fri 03', 'Sat 04'];
  const times = ['10:00 AM', '11:30 AM', '02:00 PM', '04:30 PM'];

  function showStep(key){ Object.values(steps).forEach(el => el.classList.remove('active')); steps[key].classList.add('active'); }

  function renderMetrics(){
    $('gc-metrics').innerHTML = metrics.map(([label, score]) =>
      `<article class="gc-metric"><strong>${label}</strong><p>${score}%</p></article>`).join('');
  }

  function buildChoices(node, items, onPick){
    node.innerHTML = items.map(v => `<button type="button" class="gc-choice" data-v="${v}">${v}</button>`).join('');
    node.querySelectorAll('.gc-choice').forEach(btn => btn.addEventListener('click', () => {
      node.querySelectorAll('.gc-choice').forEach(el => el.classList.remove('active'));
      btn.classList.add('active');
      onPick(btn.dataset.v);
      $('gc-finalize').disabled = !(state.selectedDate && state.selectedTime);
    }));
  }

  $('gc-form').addEventListener('submit', (e) => {
    e.preventDefault();
    state.url = $('gc-url').value.trim();
    state.comp = $('gc-comp').value.trim();
    state.email = $('gc-email').value.trim();
    $('gc-live').textContent = `Live audit: ${state.url}`;
    $('gc-scan-text').textContent = `Casting spells on ${state.url}`;
    showStep('scan');

    let progress = 0;
    const interval = setInterval(() => {
      progress += 5;
      $('gc-progress-bar').style.width = `${progress}%`;
      if (progress >= 100) {
        clearInterval(interval);
        $('gc-report-target').textContent = `Analyzed for ${state.url}`;
        const rival = $('gc-rival');
        if (state.comp) {
          rival.hidden = false;
          rival.innerHTML = `<strong>Rivalry mode:</strong> You (82) vs Rival (71) • ${state.comp}`;
        } else {
          rival.hidden = true;
        }
        renderMetrics();
        showStep('report');
      }
    }, 130);
  });

  $('gc-voice').addEventListener('click', () => {
    if (!('speechSynthesis' in window)) return;
    window.speechSynthesis.cancel();
    const utter = new SpeechSynthesisUtterance(
      `Greetings. I scanned ${state.url}. Speed is strong but conversion can improve. Focus your mobile calls to action.`
    );
    utter.rate = 0.94;
    window.speechSynthesis.speak(utter);
  });

  $('gc-mock').addEventListener('click', () => {
    const svg = encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1200 630'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop stop-color='#4338ca'/><stop offset='1' stop-color='#7e22ce'/></linearGradient></defs><rect width='1200' height='630' fill='#0f172a'/><rect x='80' y='80' width='1040' height='470' rx='28' fill='url(#g)' opacity='.95'/><text x='140' y='220' fill='white' font-size='62' font-family='Arial'>${state.url || 'Your Brand'}</text><text x='140' y='300' fill='#c7d2fe' font-size='34' font-family='Arial'>Modern hero concept generated for Magic Audit</text><rect x='140' y='360' width='260' height='62' rx='12' fill='white'/><text x='195' y='402' fill='#3730a3' font-size='30' font-family='Arial'>Book Now</text></svg>`);
    $('gc-mockup').innerHTML = `<img alt="AI Vision Mockup" src="data:image/svg+xml;charset=utf-8,${svg}" />`;
  });

  $('gc-next').addEventListener('click', () => {
    buildChoices($('gc-date-options'), dates, (v) => state.selectedDate = v);
    buildChoices($('gc-time-options'), times, (v) => state.selectedTime = v);
    $('gc-book-status').textContent = '';
    showStep('book');
  });

  $('gc-finalize').addEventListener('click', async () => {
    const status = $('gc-book-status');
    const btn = $('gc-finalize');
    status.textContent = 'Submitting your booking...';
    btn.classList.add('gc-loading');
    btn.disabled = true;

    try {
      const endpoint = `${window.location.origin}/wp-json/gc-audit/v1/book`;
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          siteUrl: state.url,
          competitorUrl: state.comp,
          leadEmail: state.email,
          selectedDate: state.selectedDate,
          selectedTime: state.selectedTime
        })
      });

      const data = await response.json().catch(() => ({}));
      if (!response.ok || !data.ok) {
        throw new Error(data.message || 'Booking failed.');
      }

      $('gc-success-copy').textContent = `Your strategy session for ${state.url} is booked for ${state.selectedDate} at ${state.selectedTime}. We emailed Gemini Creative at geminicreativeNF@gmail.com and sent a confirmation to ${state.email}.`;
      status.textContent = '';
      showStep('success');
    } catch (err) {
      status.textContent = `Could not send booking email: ${err.message}. Please check plugin activation and SMTP.`;
      btn.disabled = !(state.selectedDate && state.selectedTime);
    } finally {
      btn.classList.remove('gc-loading');
    }
  });

  $('gc-reset').addEventListener('click', () => {
    state.url = ''; state.comp = ''; state.email = ''; state.selectedDate = ''; state.selectedTime = '';
    $('gc-form').reset();
    $('gc-progress-bar').style.width = '0%';
    $('gc-mockup').textContent = 'No mockup generated yet.';
    $('gc-live').textContent = 'Live audit: None';
    $('gc-book-status').textContent = '';
    showStep('input');
  });
})();
</script>
<!-- /wp:html -->
      ]]></content:encoded>
